# Secrets and local environment
.env
.env.*
!.env.example
*.pem
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
uv.lock.bak

# Runtime output. The directories themselves are tracked, via a .gitkeep, because
# docker-compose.yml bind-mounts them and Docker would otherwise create them
# root-owned on a clean clone. Only their contents are ignored.
logs/*
!logs/.gitkeep
*.log
exports/*
!exports/.gitkeep
reports/*.csv
reports/*.json
storage/*
!storage/.gitkeep

# Editors and OS
.DS_Store
.idea/
.vscode/

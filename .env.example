# Copy to .env and fill in. .env is git-ignored and never committed (CLAUDE.md rule 20).

# Two runtime roles and only two, plus a read-only role for reporting (rule 11).
# The role is chosen by which URL is read, never by a code path.
DATABASE_URL_PIPELINE=postgresql://monitor_pipeline:CHANGE_ME@localhost:5432/monitor
DATABASE_URL_REVIEW=postgresql://monitor_review:CHANGE_ME@localhost:5432/monitor
DATABASE_URL_READONLY=postgresql://monitor_readonly:CHANGE_ME@localhost:5432/monitor

# Migrations only. monitor/migrate.py is the one thing that connects as the owner, and it is
# not runtime: no code path under monitor/ or review/ can reach this URL. The role needs
# CREATEROLE, which the compose superuser has. Its password is POSTGRES_PASSWORD below.
DATABASE_URL_OWNER=postgresql://monitor_owner:CHANGE_ME@localhost:5432/monitor

# Set on the three roles by monitor/migrate.py after the migrations apply; never in a .sql file.
# The owner role's password. It is the same credential as the one in the owner connection
# string, so the two must be set to the same value or the migration cannot log in to the
# database compose just started.
POSTGRES_PASSWORD=CHANGE_ME
MONITOR_PIPELINE_PASSWORD=CHANGE_ME
MONITOR_REVIEW_PASSWORD=CHANGE_ME
MONITOR_READONLY_PASSWORD=CHANGE_ME

# How the model is reached. Set it explicitly; nothing is detected and nothing falls
# back, because which credential a deployment uses is a decision rather than a branch.
#
#   direct  the key is here, in ANTHROPIC_API_KEY. Local runs and the pilot host.
#   proxy   the key is held by Anthropic's agent proxy on the cloud environment and
#           attached after the request leaves the sandbox. Leave ANTHROPIC_API_KEY
#           empty: the key is never in the environment, a log or an image, which is
#           why this is the better route where it is available. Needs an org admin
#           role and a Pro or Max plan; add it under API credentials in the cloud
#           environment dialog, with api.anthropic.com as the host.
#   bedrock arrives at step 12 for the ca-central-1 cutover.
MODEL_ROUTE=direct
ANTHROPIC_API_KEY=

# Acquisition ethics (rule 21): identified user agent, contact address reachable.
MONITOR_USER_AGENT="FreeBalance-OpportunityMonitor/0.1 (+CONTACT_EMAIL_HERE)"

# Hard caps checked before every model call (rule 22) live in
# config/thresholds.yaml (daily_call_cap, daily_usd_cap), because rule 6 puts a
# threshold in config rather than in one deployment's environment.
#
# These two variables OVERRIDE that config when set, and are deliberately left
# unset. They exist for one purpose: scripts/drills/drill3_call_cap.py sets the
# call cap low to prove a run stops before the call rather than after it.
#
# Setting them permanently is how the enforced cap stops matching the documented
# one. The day the config went from 600 to 2,000, a DAILY_CALL_CAP=600 left in
# .env meant the deployment carried on enforcing 600, and a translation run died
# 545 calls in still reporting "cap is 600".
# DAILY_CALL_CAP=
# DAILY_USD_CAP=
